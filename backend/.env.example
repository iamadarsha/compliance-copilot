# Copy to backend/.env and fill in. docker-compose loads this file for the
# backend service. DATABASE_URL is overridden by docker-compose (the container
# reaches postgres by service name); the value here is for running the backend
# directly on the host.
DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliance_copilot

# Generation runs Gemini-primary with Groq as failover, so BOTH keys are needed
# for the fallback to have anything to fall back to. With only GROQ_API_KEY set
# the app still works — every request just fails over to Groq after Gemini
# errors on the missing credential, which costs a wasted round trip per query.
GEMINI_API_KEY=
GROQ_API_KEY=

# Layer-1 refusal gate: minimum top cosine similarity required before the
# generation model is called at all. Optional, defaults to 0.69 — tuned in
# Phase 5's eval against real distractor scores (see run_eval.py's threshold
# analysis). Re-tune if the document corpus changes materially.
SIMILARITY_THRESHOLD=0.69
